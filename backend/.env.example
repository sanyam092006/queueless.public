# Copy this file to .env and fill in real values. NEVER commit .env.
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (replace user, password, cluster)
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/queueless?retryWrites=true&w=majority

# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Allowed frontend origin(s), comma separated, no trailing slash
CLIENT_URL=http://localhost:5173
